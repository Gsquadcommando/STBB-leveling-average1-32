-- Alt Keys
local function setMode(mode)
    keyMode = mode
    if mode == 1 then
        useAltKeys = false; m1Only = false
        for i, ab in ipairs(abilityKeys) do ab.key = defaultKeys[i] end
    elseif mode == 2 then
        useAltKeys = true; m1Only = false
        for i, ab in ipairs(abilityKeys) do ab.key = altKeys[i] or defaultKeys[i] end
    else
        useAltKeys = false; m1Only = true
    end
    for i, b in ipairs(modeButtons) do
        b.BackgroundColor3 = (i == mode) and MODE_ON or MODE_OFF
    end
    modeTitle.Text = "🎮 Mode: " .. (mode == 1 and "Default" or mode == 2 and "Alt Keys" or "M1 Only")
