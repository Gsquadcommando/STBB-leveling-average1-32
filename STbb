-- ====================== AUTO COLLECT (Gacha Capsule) ======================
local COLLECT_BASE_RANGE  = 1
local COLLECT_INCREMENT   = 1
local COLLECT_MAX_RANGE   = 30
local COLLECT_COOLDOWN    = 0.1

local collectRange        = COLLECT_BASE_RANGE
local collectRespawnCount = 0
local lastCollectItem     = nil
local lastCollectTime     = 0

local function getCapsuleItem()
    local capsule = workspace:FindFirstChild("Gacha Capsule")
    if not capsule then return nil end
    return capsule:GetChildren()[4]
end

local collectBtns, collectBtnTime = {}, 0
local function tryCollect(item)
    for _, v in ipairs(item:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(v) end)
        elseif v:IsA("ClickDetector") then
            pcall(function() fireclickdetector(v) end)
        end
    end
    pcall(function()
        VIM:SendKeyEvent(true,  Enum.KeyCode.F, false, game)
        VIM:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.03)
        VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    pcall(function()
        if tick() - collectBtnTime > 2 then
            collectBtnTime = tick()
            collectBtns = {}
            local pg = lp:FindFirstChild("PlayerGui")
            if pg then
                for _, v in ipairs(pg:GetDescendants()) do
                    if v:IsA("TextButton") or v:IsA("ImageButton") then
                        local n = v.Name:lower()
                        if n:find("pick") or n:find("collect") or n:find("grab")
                        or n:find("take") or n:find("open") or n:find("claim")
                        or n:find("gacha") or n:find("capsule") then
                            table.insert(collectBtns, v)
                        end
                    end
                end
            end
        end
        for _, v in ipairs(collectBtns) do
            if v.Parent and v.Visible then
                local ap = v.AbsolutePosition
                local as = v.AbsoluteSize
                local cx, cy = ap.X + as.X/2, ap.Y + as.Y/2
                VIM:SendMouseButtonEvent(cx, cy, 0, true,  game, 1)
                task.wait(0.02)
                VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            end
        end
    end)
end

local function autoCollect()
    if tick() - lastCollectTime < COLLECT_COOLDOWN then return end
    local root = getActiveRoot()
    if not root then return end

    local item = getCapsuleItem()
    if lastCollectItem and item ~= lastCollectItem then
        collectRespawnCount = collectRespawnCount + 1
        collectRange = math.min(
            COLLECT_BASE_RANGE + (collectRespawnCount * COLLECT_INCREMENT),
            COLLECT_MAX_RANGE
        )
    end
    lastCollectItem = item
    if not item then return end

    local itemPos
    if item:IsA("BasePart") then
        itemPos = item.Position
    elseif item:IsA("Model") then
        local pp = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        if pp then itemPos = pp.Position end
    end
    if not itemPos then return end

    if (root.Position - itemPos).Magnitude > collectRange then
        root.CFrame = CFrame.new(itemPos + Vector3.new(0,3,0), itemPos)
        task.wait()
    else
        tryCollect(item)
        lastCollectTime = tick()
    end
end

