-- ====================== TARGETS (cached, event driven) ======================
local enemyList = {}
for en in pairs(enemySet) do table.insert(enemyList, en) end
local exceptionList = {}
for ex in pairs(exceptionSet) do table.insert(exceptionList, ex) end

local enemyModels = {}
local checked = {}
local humOf = {}

local function evaluateModel(model)
    if checked[model] ~= nil then return end
    if not model:IsA("Model") then return end
    local nl = model.Name:lower()
    local isEnemy = false
    for i = 1, #enemyList do
        if nl:find(enemyList[i], 1, true) then
            isEnemy = true
            break
        end
    end
    if isEnemy then
        for i = 1, #exceptionList do
            if nl:find(exceptionList[i], 1, true) then
                isEnemy = false
                break
            end
        end
    end
    checked[model] = isEnemy
    if isEnemy then enemyModels[model] = true end
end

local function onAdded(inst)
    if inst.Name == "HumanoidRootPart" then
        local m = inst.Parent
        if m and m:IsA("Model") then evaluateModel(m) end
    end
end
local function onRemoving(inst)
    enemyModels[inst] = nil
    checked[inst] = nil
    humOf[inst] = nil
end
Workspace.DescendantAdded:Connect(onAdded)
Workspace.DescendantRemoving:Connect(onRemoving)
task.spawn(function()
    local count = 0
    for _, inst in ipairs(Workspace:GetDescendants()) do
        onAdded(inst)
        count = count + 1
        if count % 1500 == 0 then task.wait() end
    end
end)

local function getTargets()
    local targets = {}
    local n = 0
    local myChar = lp.Character
    for model in pairs(enemyModels) do
        if model.Parent then
            if model ~= myChar then
                local hum = humOf[model]
                if not hum or not hum.Parent then
                    hum = model:FindFirstChildWhichIsA("Humanoid")
                    humOf[model] = hum
                end
                if hum and hum.Health > 0 then
                    n = n + 1
                    targets[n] = model
                end
            end
        else
            enemyModels[model] = nil
            checked[model] = nil
            humOf[model] = nil
        end
    end
    return targets
end
local function getClosest(targets)
    local root = getActiveRoot()
    if not root then return nil, math.huge end
    local best, dist = nil, math.huge
    for _, t in pairs(targets) do
        local hrp = t:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - root.Position).Magnitude
            if d < dist then dist=d; best=t end
        end
    end
    return best, dist
end

-- ====================== MOVEMENT ======================
local function faceTarget(target)
    local root = getActiveRoot()
    if not root or not target then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if hrp then
        root.CFrame = CFrame.new(root.Position, Vector3.new(hrp.Position.X,root.Position.Y,hrp.Position.Z))
    end
end
local function teleportTo(target)
    local root = getActiveRoot()
    if not root or not target then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if hrp then
        local size = math.max(2, hrp.Size.Magnitude/2)
        local offset = hrp.CFrame.LookVector * -(size+2)
        root.CFrame = CFrame.new(hrp.Position+offset+Vector3.new(0,5,0), hrp.Position)
    end
end

